<settings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <group id="watch" title="@Strings.GroupWatch" description="@Strings.GroupWatchPrompt">
        <setting propertyKey="@Properties.TempUnit" title="@Strings.TempUnitTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.UnitF</listEntry>
                <listEntry value="1">@Strings.UnitC</listEntry>
                <listEntry value="2">@Strings.UnitWatch</listEntry>
            </settingConfig>
        </setting>
        <setting propertyKey="@Properties.AutoRounds" title="@Strings.AutoRoundsTitle" prompt="@Strings.AutoRoundsPrompt">
            <settingConfig type="boolean"/>
        </setting>
        <setting propertyKey="@Properties.DoorSensitivity" title="@Strings.DoorTitle" prompt="@Strings.DoorPrompt">
            <settingConfig type="list">
                <listEntry value="10">@Strings.DoorNormal</listEntry>
                <listEntry value="6">@Strings.DoorEager</listEntry>
                <listEntry value="15">@Strings.DoorRelaxed</listEntry>
            </settingConfig>
        </setting>
        <setting propertyKey="@Properties.HotWatch" title="@Strings.HotWatchTitle" prompt="@Strings.HotWatchPrompt">
            <settingConfig type="list">
                <listEntry value="45">@Strings.Hot45</listEntry>
                <listEntry value="50">@Strings.Hot50</listEntry>
                <listEntry value="55">@Strings.Hot55</listEntry>
                <listEntry value="0">@Strings.HotOff</listEntry>
            </settingConfig>
        </setting>
        <setting propertyKey="@Properties.ActivityType" title="@Strings.ActivityTypeTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.TypeMeditation</listEntry>
                <listEntry value="1">@Strings.TypeGeneric</listEntry>
            </settingConfig>
        </setting>
    </group>

    <group id="coach" title="@Strings.GroupCoach" description="@Strings.GroupCoachPrompt">
        <setting propertyKey="@Properties.CoachHrHigh" title="@Strings.CoachHrHighTitle" prompt="@Strings.CoachHrHighPrompt">
            <settingConfig type="boolean"/>
        </setting>
        <setting propertyKey="@Properties.HrCeiling" title="@Strings.HrCeilingTitle" prompt="@Strings.HrCeilingPrompt">
            <settingConfig type="numeric" min="0" max="220"/>
        </setting>
        <setting propertyKey="@Properties.CoachRecovery" title="@Strings.CoachRecoveryTitle" prompt="@Strings.CoachRecoveryPrompt">
            <settingConfig type="boolean"/>
        </setting>
        <setting propertyKey="@Properties.RecoveryHr" title="@Strings.RecoveryHrTitle">
            <settingConfig type="numeric" min="80" max="160"/>
        </setting>
        <setting propertyKey="@Properties.CoachStand" title="@Strings.CoachStandTitle" prompt="@Strings.CoachStandPrompt">
            <settingConfig type="boolean"/>
        </setting>
        <setting propertyKey="@Properties.LogHrv" title="@Strings.LogHrvTitle" prompt="@Strings.LogHrvPrompt">
            <settingConfig type="boolean"/>
        </setting>
    </group>

    <group id="sauna" title="@Strings.GroupSauna" description="@Strings.GroupSaunaPrompt">
        <setting propertyKey="@Properties.SaunaRound" title="@Strings.RoundTitle">
            <settingConfig type="numeric" min="0" max="60"/>
        </setting>
        <setting propertyKey="@Properties.SaunaMax" title="@Strings.MaxTitle" prompt="@Strings.MaxPrompt">
            <settingConfig type="numeric" min="0" max="90"/>
        </setting>
        <setting propertyKey="@Properties.SaunaBreak" title="@Strings.BreakTitle" prompt="@Strings.BreakPrompt">
            <settingConfig type="numeric" min="0" max="60"/>
        </setting>
        <setting propertyKey="@Properties.SaunaRounds" title="@Strings.RoundsTitle">
            <settingConfig type="numeric" min="1" max="12"/>
        </setting>
        <setting propertyKey="@Properties.SaunaCap" title="@Strings.CapTitle" prompt="@Strings.CapPrompt">
            <settingConfig type="numeric" min="0" max="180"/>
        </setting>
        <setting propertyKey="@Properties.SaunaWeekSessions" title="@Strings.WeekSessionsTitle">
            <settingConfig type="numeric" min="1" max="14"/>
        </setting>
        <setting propertyKey="@Properties.SaunaWeekMinutes" title="@Strings.WeekMinutesTitle">
            <settingConfig type="numeric" min="1" max="600"/>
        </setting>
    </group>

    <group id="steam" title="@Strings.GroupSteam" description="@Strings.GroupSteamPrompt">
        <setting propertyKey="@Properties.SteamRound" title="@Strings.RoundTitle">
            <settingConfig type="numeric" min="0" max="60"/>
        </setting>
        <setting propertyKey="@Properties.SteamMax" title="@Strings.MaxTitle" prompt="@Strings.MaxPrompt">
            <settingConfig type="numeric" min="0" max="90"/>
        </setting>
        <setting propertyKey="@Properties.SteamBreak" title="@Strings.BreakTitle" prompt="@Strings.BreakPrompt">
            <settingConfig type="numeric" min="0" max="60"/>
        </setting>
        <setting propertyKey="@Properties.SteamRounds" title="@Strings.RoundsTitle">
            <settingConfig type="numeric" min="1" max="12"/>
        </setting>
        <setting propertyKey="@Properties.SteamCap" title="@Strings.CapTitle" prompt="@Strings.CapPrompt">
            <settingConfig type="numeric" min="0" max="180"/>
        </setting>
        <setting propertyKey="@Properties.SteamWeekSessions" title="@Strings.WeekSessionsTitle">
            <settingConfig type="numeric" min="1" max="14"/>
        </setting>
        <setting propertyKey="@Properties.SteamWeekMinutes" title="@Strings.WeekMinutesTitle">
            <settingConfig type="numeric" min="1" max="600"/>
        </setting>
    </group>
</settings>
