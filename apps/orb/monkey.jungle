project.manifest = manifest.xml

# Unit tests (tests/) are annotated (:test) and only compiled with --unit-test
base.sourcePath = source;tests

# Shared code: the Lib barrel at the repo root (lib/). Only the annotated
# sub-modules listed here are compiled into this app.
base.barrelPath = ../../lib/monkey.jungle
base.Lib.annotations = aod;fmt;sun;daily;slots;ink;config;look;watchmenu;numbers;motion;timing

# A build with sample readings for screenshots, held still (sample.jungle),
# or with a wake every few seconds and each motion's cost logged
# (sample-motion.jungle):
#   CIQ_JUNGLE="monkey.jungle;sample.jungle" scripts/build.sh orb <device>
# Normal builds leave the samples out.
base.excludeAnnotations = sample;still;demo
