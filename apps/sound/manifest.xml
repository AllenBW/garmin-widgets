<?xml version="1.0"?>
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <!-- A watch-app with a glance: the microphone (AudioInput) is allowed
         for device apps and audio providers only, not widgets. The glance
         row shows the last reading and opens the meter. Audio arrived with
         API 6.0.3, which every fēnix 8 runs. -->
    <iq:application id="b22fbd9e33eb4a3eb8c51d5f1cd3b4a8" type="watch-app" name="@Strings.AppName" entry="SoundApp" launcherIcon="@Drawables.LauncherIcon" minApiLevel="6.0.3">
        <iq:products>
            <!-- fenix 8 Pro: one ID covers 47 mm, 51 mm and MicroLED (454x454) -->
            <iq:product id="fenix8pro47mm"/>
            <!-- fenix 8 AMOLED: 43 mm, and one ID for 47 mm / 51 mm -->
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
        </iq:products>
        <iq:permissions>
            <!-- the microphone, while the app is open; nothing is kept -->
            <iq:uses-permission id="AudioInput"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels>
            <iq:depends name="Lib" version="0.1.0"/>
        </iq:barrels>
    </iq:application>
</iq:manifest>
