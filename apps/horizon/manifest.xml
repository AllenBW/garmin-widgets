<?xml version="1.0"?>
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application id="8bc6b803d63e4336b0d7e780909abfb1" type="watchface" name="@Strings.AppName" entry="HorizonApp" launcherIcon="@Drawables.LauncherIcon" minApiLevel="5.0.0">
        <iq:products>
            <!-- fenix 8 Pro: one ID covers 47 mm, 51 mm and MicroLED (454x454) -->
            <iq:product id="fenix8pro47mm"/>
            <!-- fenix 8 AMOLED: 43 mm, and one ID for 47 mm / 51 mm -->
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
        </iq:products>
        <iq:permissions>
            <!-- the next calendar event, and sunrise/sunset when no location is known -->
            <iq:uses-permission id="ComplicationSubscriber"/>
            <!-- the watch's last GPS fix for the sun maths; nothing is switched on -->
            <iq:uses-permission id="Positioning"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels>
            <iq:depends name="Lib" version="0.1.0"/>
        </iq:barrels>
    </iq:application>
</iq:manifest>
