project.manifest = manifest.xml

# Unit tests (tests/) are annotated (:test) and only compiled with --unit-test
base.sourcePath = source;tests

# Shared code: the Lib barrel at the repo root (lib/). Only the annotated
# sub-modules listed here are compiled into this app.
base.barrelPath = ../../lib/monkey.jungle
base.Lib.annotations = aod;fmt;sun;daily;slots;ink;look;numbers;motion

# A build with sample readings for screenshots, at rest (sample.jungle), as
# a wake seven minutes after the last look (sample-wake.jungle) or held in
# standby (sample-standby.jungle):
#   CIQ_JUNGLE="monkey.jungle;sample.jungle" scripts/build.sh ticker <device>
# Normal builds leave the samples out.
base.excludeAnnotations = sample;rested;wake;standby;lit
