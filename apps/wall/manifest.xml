<?xml version="1.0"?>
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application id="5e82b7a1c04f4d39a6e2147f0d9bc3a6" type="watchface" name="@Strings.AppName" entry="WallApp" launcherIcon="@Drawables.LauncherIcon" minApiLevel="5.0.0">
        <iq:products>
            <!-- fenix 8 Pro: one ID covers 47 mm, 51 mm and MicroLED (454x454) -->
            <iq:product id="fenix8pro47mm"/>
            <!-- fenix 8 AMOLED: 43 mm, and one ID for 47 mm / 51 mm -->
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
            <iq:product id="venu441mm"/>
        </iq:products>
        <iq:permissions>
            <!-- the sun's times and Body Battery; press-and-hold opens a reading's widget -->
            <iq:uses-permission id="ComplicationSubscriber"/>
            <!-- without this the weather observation position is null on a watch (EXPLORATION.md 10.1) -->
            <iq:uses-permission id="Positioning"/>
            <!-- Body Battery and altitude history -->
            <iq:uses-permission id="SensorHistory"/>
            <!-- Lib.Slots links the heart rate zones, though this face doesn't read them -->
            <iq:uses-permission id="UserProfile"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels>
            <iq:depends name="Lib" version="0.1.0"/>
        </iq:barrels>
    </iq:application>
</iq:manifest>
