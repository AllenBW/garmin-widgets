<properties xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <!-- Lib.Look: 0 the face's own colours, 1 high visibility orange, 2 low light, 3 a new look each day, 4 high visibility blue, 5 high visibility green -->
    <property id="Look" type="number">0</property>
    <!-- Lib.Numbers.MUTED: every other week, from Monday, the daily look is a muted one -->
    <property id="MutedWeeks" type="boolean">true</property>
    <property id="SlidingDigits" type="boolean">true</property>
</properties>
