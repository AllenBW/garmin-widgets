<?xml version="1.0"?>
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <!-- A widget: a row in the glance loop that opens into the buttons -->
    <iq:application id="439b7bc52a9746dca7c1dab14f5f29e1" type="widget" name="@Strings.AppName" entry="TallyApp" launcherIcon="@Drawables.LauncherIcon" minApiLevel="5.0.0">
        <iq:products>
            <!-- fenix 8 Pro: one ID covers 47 mm, 51 mm and MicroLED (454x454) -->
            <iq:product id="fenix8pro47mm"/>
            <!-- fenix 8 AMOLED: 43 mm, and one ID for 47 mm / 51 mm -->
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
        </iq:products>
        <iq:permissions>
            <!-- entries waiting for the sheet are sent by a background service -->
            <iq:uses-permission id="Background"/>
            <!-- the sheet: a web request through the phone or Wi-Fi -->
            <iq:uses-permission id="Communications"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels>
            <iq:depends name="Lib" version="0.1.0"/>
        </iq:barrels>
    </iq:application>
</iq:manifest>
