<settings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <!-- Up to six codes, added and removed as a list in the Connect IQ / Garmin Connect app -->
    <setting propertyKey="@Properties.Codes" title="@Strings.CodesTitle" maxLength="6">
        <setting title="@Strings.CodeNameTitle" type="string">
            <settingConfig id="name" type="alphaNumeric" maxLength="24"/>
        </setting>
        <setting title="@Strings.CodeValueTitle" prompt="@Strings.CodeValuePrompt" type="string">
            <settingConfig id="value" type="alphaNumeric" maxLength="300" required="true"/>
        </setting>
        <defaults>
            <entry>
                <default id="name">Example</default>
                <default id="value">Hello from Pocket QR</default>
            </entry>
        </defaults>
    </setting>
</settings>
