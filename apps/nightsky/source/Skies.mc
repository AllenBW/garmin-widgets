import Toybox.Application;
import Toybox.Application.WatchFaceConfig;
import Toybox.Lang;

// Night Sky's colours: a palette, one colour a place, from the sky chosen
// (Theme: the phone's Sky, the editor's style) and the time colour
// (TimeColor: the editor's accent colour, only these), whichever of the
// phone and the editor was changed last; or by the look (Lib.Look): high
// visibility, low light, or the next sky each day with its own time colour.
// The numbers are stored on watches, so new skies and colours go at the end.
module Skies {

    const STAR1 = 0;       // the brightest stars
    const STAR2 = 1;       // magnitude 1.5 to 2.5
    const STAR3 = 2;       // the faintest
    const STAR4 = 3;       // the stars by day
    const LINE = 4;        // the constellation lines
    const VENUS = 5;       // Venus
    const MARS = 6;        // Mars
    const JUPITER = 7;     // Jupiter
    const SATURN = 8;      // Saturn
    const MOON = 9;        // the Moon's lit side
    const SUN = 10;        // the Sun
    const HORIZON = 11;    // the horizon, the compass, the letters, the Moon's dark side
    const TEXT = 12;       // the date
    const FAINT = 13;      // standby's stars
    const TIME = 14;       // the time

    // The skies (Clear, Red light, Moonlit, Desert, Aurora), each with the time
    // colour the daily look gives it
    const SETS = [
        [0xF2F2F2, 0xC8C8C8, 0x8A8A8A, 0x5A5A5A, 0x161E33, 0xFFFFFF, 0xFF6B4A, 0xF2E6C8, 0xE8D8A0, 0xF2F2F2, 0xFFB020, 0x5A5A5A, 0x8A8A8A, 0x5A5A5A, 0xF2F2F2] as Array<Number>,
        [0xFF4A36, 0xD0362A, 0x96261C, 0x5E1810, 0x2E0C08, 0xFF7A60, 0xE8402A, 0xFF9A7A, 0xD8705A, 0xFF5A44, 0xFF6A2A, 0x6A1C14, 0x9A2A1E, 0x5E1810, 0xFF4A36] as Array<Number>,
        [0xE0EAFF, 0xB0C0E8, 0x7484B0, 0x4A5478, 0x1E2C5C, 0xFFFFFF, 0xFF6B4A, 0xF2E6C8, 0xE8D8A0, 0xE0EAFF, 0xFFB020, 0x4A5478, 0x8090B8, 0x4A5478, 0xE0EAFF] as Array<Number>,
        [0xFFF0D8, 0xE0CCA8, 0xA08A6A, 0x685A44, 0x2A2014, 0xFFFFFF, 0xFF6B4A, 0xF2E6C8, 0xE8D8A0, 0xFFF0D8, 0xFFB020, 0x685A44, 0xA08A6A, 0x685A44, 0xFFF0D8] as Array<Number>,
        [0xF2F2F2, 0xC8D8D0, 0x8A9A92, 0x52605A, 0x0E3A2A, 0xFFFFFF, 0xFF6B4A, 0xF2E6C8, 0xE8D8A0, 0xF2F2F2, 0xFFB020, 0x2A7A5A, 0x5CB490, 0x52605A, 0x9CF0C8] as Array<Number>
    ] as Array<Array<Number>>;
    const NAMES = ["CLEAR", "RED LIGHT", "MOONLIT", "DESERT", "AURORA"] as Array<String>;

    // The time colours: White, Starlight, Moonlight, Red light, Aurora
    const TIMES = [0xF2F2F2, 0xFFF0D8, 0xD8E4FF, 0xFF4A36, 0x9CF0C8] as Array<Number>;

    // The looks' palettes: high visibility in orange, blue and green, and low light
    const BRIGHT = [0xFFFFFF, 0xE8E8E8, 0xB4B4B4, 0x7A7A7A, 0x4C1F05, 0xFFFFFF, 0xFF6B4A, 0xF2E6C8, 0xE8D8A0, 0xFFFFFF, 0xFF6A13, 0xFF6A13, 0xFFFFFF, 0x7A7A7A, 0xFFFFFF] as Array<Number>;
    const BRIGHT_BLUE = [0xFFFFFF, 0xE8E8E8, 0xB4B4B4, 0x7A7A7A, 0x0D324C, 0xFFFFFF, 0xFF6B4A, 0xF2E6C8, 0xE8D8A0, 0xFFFFFF, 0x2EA8FF, 0x2EA8FF, 0xFFFFFF, 0x7A7A7A, 0xFFFFFF] as Array<Number>;
    const BRIGHT_GREEN = [0xFFFFFF, 0xE8E8E8, 0xB4B4B4, 0x7A7A7A, 0x1B4C0D, 0xFFFFFF, 0xFF6B4A, 0xF2E6C8, 0xE8D8A0, 0xFFFFFF, 0x5CFF2E, 0x5CFF2E, 0xFFFFFF, 0x7A7A7A, 0xFFFFFF] as Array<Number>;
    const LOW = [0xF0D2A8, 0xC8AE88, 0x8E7A60, 0x5E5040, 0x2A1E14, 0xF0D2A8, 0xFF9A3C, 0xE8C8A0, 0xD8B888, 0xF0D2A8, 0xFF9A3C, 0x5E4A36, 0xA88A68, 0x5E4A36, 0xF0D2A8] as Array<Number>;

    const KEYS = ["Theme", "TimeColor"] as Array<String>;   // the phone's settings
    const SOURCE = "Source";          // in storage: "phone" or "editor", whichever was changed last
    const PHONE = "phone";
    const EDITOR = "editor";

    // [the sky, the time colour] chosen: in the phone app (or the watch's
    // settings menu), or in the watch face editor unless the phone was
    // changed since
    function chosen() as [Number, Number] {
        var sky = number(KEYS[0], SETS.size());
        var time = number(KEYS[1], TIMES.size());
        if (Application has :WatchFaceConfig && !PHONE.equals(Application.Storage.getValue(SOURCE))) {
            var config = WatchFaceConfig.getSettings(null);
            if (config != null) {
                var style = config.styleId;
                if (style != null && style >= 0 && style < SETS.size()) {
                    sky = style;
                }
                var picked = config.accentColor;
                if (picked != null && picked.color != null) {
                    time = nearest(picked.color as Number);
                }
            }
        }
        return [sky, time];
    }

    // A phone setting's choice, 0 until one is made (or out of range)
    function number(key as String, count as Number) as Number {
        var v = null;
        try {
            v = Application.Properties.getValue(key);
        } catch (e) {
            v = null;
        }
        return (v instanceof Number && v >= 0 && v < count) ? v : 0;
    }

    // The time colour nearest a colour: the editor offers only these, so
    // this is the colour itself; anything else snaps to the list
    function nearest(color as Number) as Number {
        var best = 0;
        var least = -1;
        for (var i = 0; i < TIMES.size(); i++) {
            var dr = ((TIMES[i] >> 16) & 0xFF) - ((color >> 16) & 0xFF);
            var dg = ((TIMES[i] >> 8) & 0xFF) - ((color >> 8) & 0xFF);
            var db = (TIMES[i] & 0xFF) - (color & 0xFF);
            var d = dr * dr + dg * dg + db * db;
            if (least < 0 || d < least) {
                least = d;
                best = i;
            }
        }
        return best;
    }

    // From onSettingsChanged: the phone app's choices win until the editor
    // is next used (and a new Look there is taken up)
    function changedOnPhone() as Void {
        Application.Storage.setValue(SOURCE, PHONE);
        Lib.Look.changedOnPhone();
    }

    // From onWatchFaceConfigEdited: the editor's choices win
    function changedInEditor() as Void {
        Application.Storage.setValue(SOURCE, EDITOR);
    }

    // The look's palette: `yours` (the sky, the time colour) in the
    // wearer's own look, the sky of day `day` in the daily one
    function palette(mode as Number, yours as [Number, Number], day as Number) as Array<Number> {
        if (mode == Lib.Look.BRIGHT) {
            return BRIGHT;
        }
        if (mode == Lib.Look.BRIGHT_BLUE) {
            return BRIGHT_BLUE;
        }
        if (mode == Lib.Look.BRIGHT_GREEN) {
            return BRIGHT_GREEN;
        }
        if (mode == Lib.Look.LOW) {
            return LOW;
        }
        if (mode == Lib.Look.DAILY) {
            return SETS[day % SETS.size()];
        }
        var out = SETS[yours[0]].slice(0, null);
        out[TIME] = TIMES[yours[1]];
        return out;
    }

    // The look's palette now
    function colors(mode as Number) as Array<Number> {
        return palette(mode, chosen(), Lib.Look.day(SETS.size()));
    }

    // The look's name, in capitals: a sky's in the daily look
    function title(mode as Number) as String {
        return Lib.Look.title(mode, NAMES);
    }

    // The time colour dimmed for standby, as the face has always drawn it
    // there (0xF2F2F2 to 0x8A8A8A)
    function standby(color as Number) as Number {
        var r = ((color >> 16) & 0xFF) * 138 / 242;
        var g = ((color >> 8) & 0xFF) * 138 / 242;
        var b = (color & 0xFF) * 138 / 242;
        return (r << 16) | (g << 8) | b;
    }
}
