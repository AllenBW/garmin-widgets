            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
        </iq:products>
        <iq:permissions>
            <!-- the watch's last GPS fix, to know which sky is overhead; nothing is switched on -->
            <iq:uses-permission id="Positioning"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels>
            <iq:depends name="Lib" version="0.1.0"/>
        </iq:barrels>
    </iq:application>
</iq:manifest>
