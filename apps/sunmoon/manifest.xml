<?xml version="1.0"?>
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <!-- A widget: a row in the glance loop that opens into the full app -->
    <iq:application id="68ac34b2cf15487cb76268a4d3015d4c" type="widget" name="@Strings.AppName" entry="SunApp" launcherIcon="@Drawables.LauncherIcon" minApiLevel="5.0.0">
        <iq:products>
            <!-- fenix 8 Pro: one ID covers 47 mm, 51 mm and MicroLED (454x454) -->
            <iq:product id="fenix8pro47mm"/>
            <!-- fenix 8 AMOLED: 43 mm, and one ID for 47 mm / 51 mm -->
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
        </iq:products>
        <iq:permissions>
            <!-- only to read the watch's last GPS fix; no GPS is switched on -->
            <iq:uses-permission id="Positioning"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels>
            <iq:depends name="Lib" version="0.1.0"/>
        </iq:barrels>
    </iq:application>
</iq:manifest>
