<properties xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <property id="AccentColor" type="number">0xFFB020</property>
    <!-- Ring: 0 step goal progress, 1 battery, 2 off, 3 daylight (24 h dial) -->
    <property id="Ring" type="number">3</property>
    <!-- Signals: rain ahead, pressure falling, phone disconnected, do not disturb -->
    <property id="Signals" type="boolean">true</property>
    <!-- Slot values: see Slots.mc (0 HR, 1 steps, 2 Body Battery, 3 calories, 4 floors, 5 distance,
         6 stress, 7 sunrise, 8 sunset, 9 next calendar event, 10 recovery, 11 sleep score, 12 high/low) -->
    <property id="Slot1" type="number">0</property>
    <property id="Slot2" type="number">1</property>
    <property id="Slot3" type="number">2</property>
    <!-- Footer: 0 next sun event, 1 weather and notifications, 2 off -->
    <property id="Footer" type="number">0</property>
</properties>
